{
	"name": "gitremastered",
	"version": "0.1.0",
	"description": "GitRemastered: learn Git and GitHub with real commands, a live visualizer and the Pro Git book. Runs the apps in apps/ and the shared code in packages/.",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "pnpm --filter @gitremastered/desktop dev",
		"tauri": "pnpm --filter @gitremastered/desktop tauri",
		"build": "pnpm --filter @gitremastered/desktop build",
		"test": "pnpm --recursive test",
		"test:watch": "pnpm --filter @gitremastered/desktop test:watch",
		"check": "pnpm --recursive check",
		"lint": "pnpm --recursive lint",
		"format": "pnpm --recursive format",
		"test:missions": "pnpm --filter @gitremastered/desktop test:missions",
		"test:github": "pnpm --filter @gitremastered/desktop test:github",
		"content:check": "pnpm --filter @gitremastered/course-engine content:check",
		"lesson:check": "pnpm --filter @gitremastered/course-engine lesson:check",
		"lesson:link": "pnpm --filter @gitremastered/course-engine lesson:link",
		"tokens": "pnpm --filter @gitremastered/desktop tokens",
		"review:build": "pnpm --filter @gitremastered/desktop review:build",
		"review:terminal": "pnpm --filter @gitremastered/desktop review:terminal",
		"review:measure": "pnpm --filter @gitremastered/desktop review:measure",
		"review:play": "pnpm --filter @gitremastered/desktop review:play",
		"review:fixes": "pnpm --filter @gitremastered/desktop review:fixes",
		"review:home": "pnpm --filter @gitremastered/desktop review:home",
		"review:course": "pnpm --filter @gitremastered/desktop review:course"
	},
	"packageManager": "pnpm@12.23.0"
}
