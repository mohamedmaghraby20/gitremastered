{
	"name": "gitremastered",
	"version": "0.1.0",
	"description": "GitRemastered: learn Git and GitHub with real commands, a live visualizer and the Pro Git book. Desktop app (SvelteKit + Tauri).",
	"type": "module",
	"private": true,
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm content:check && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm --filter @gitremastered/course-engine check",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run && pnpm --filter @gitremastered/course-engine test",
		"test:watch": "vitest",
		"test:missions": "vitest run --config tests/missions/vitest.config.ts",
		"test:github": "vitest run --config tests/github/vitest.config.ts",
		"content:check": "node scripts/content/check-content.ts",
		"lesson:check": "node scripts/content/check-lesson.ts",
		"lesson:link": "node scripts/content/link-lessons.ts",
		"lint": "svelte-kit sync && prettier --check . && eslint . && pnpm --filter @gitremastered/course-engine lint",
		"format": "prettier --write . && pnpm --filter @gitremastered/course-engine format",
		"tauri": "tauri",
		"tokens": "node scripts/design-tokens/build-tokens.ts",
		"review:build": "tauri build --no-bundle --config \"{\\\"identifier\\\":\\\"io.github.mohamedmaghraby20.gitremastered.review\\\"}\"",
		"review:terminal": "node scripts/review/check-terminal.ts",
		"review:measure": "node scripts/review/measure.ts",
		"review:play": "node scripts/review/play-pilot.ts",
		"review:fixes": "node scripts/review/check-review-fixes.ts",
		"review:home": "node scripts/review/check-home.ts",
		"review:course": "node scripts/review/play-course.ts"
	},
	"dependencies": {
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/source-serif-4": "^5.3.1",
		"@gitremastered/course-engine": "workspace:*",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2.7.3",
		"@tauri-apps/plugin-store": "^2.5.1",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"@xyflow/svelte": "^2.0.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.65.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/cli": "^2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.1.0",
		"cn": "^0.5.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.0.16",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"packageManager": "pnpm@12.23.0"
}
