{
	"name": "@gitremastered/course-engine",
	"version": "0.1.0",
	"description": "GitRemastered course engine: reads and checks the course content, and checks challenge goals. No screens, no Tauri.",
	"type": "module",
	"private": true,
	"license": "MIT",
	"exports": {
		"./fixtures/*": "./tests/fixtures/*.ts",
		"./*": "./src/*.ts"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "tsc --project tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"content:check": "node scripts/check-content.ts",
		"lesson:check": "node scripts/check-lesson.ts",
		"lesson:link": "node scripts/link-lessons.ts"
	},
	"dependencies": {
		"marked": "^18.3.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "^5.1.0"
	}
}
