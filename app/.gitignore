# .gitignore for the app folder. Lists generated files Git should never track.

# Downloaded JavaScript libraries (pnpm install recreates them).
node_modules

# Build output: the static screens (pnpm build) and SvelteKit's generated files.
/build
/.svelte-kit
/package

# Local secrets and settings. Only the example file is shared.
.env
.env.*
!.env.example

# Temporary files Vite leaves behind while loading its config.
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# macOS folder settings.
.DS_Store
