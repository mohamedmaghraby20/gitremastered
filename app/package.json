{
	"name": "gitremastered",
	"version": "0.1.0",
	"description": "GitRemastered desktop app: lesson screens (SvelteKit) and the Rust core (Tauri)",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "svelte-kit sync && prettier --check . && eslint .",
		"format": "prettier --write .",
		"tauri": "tauri"
	},
	"license": "MIT",
	"dependencies": {
		"@tauri-apps/api": "^2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.65.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tauri-apps/cli": "^2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.1.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.0.16",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"private": true,
	"packageManager": "pnpm@12.23.0"
}
