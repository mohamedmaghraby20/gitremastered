{
	"name": "gitremastered",
	"version": "0.1.0",
	"description": "GitRemastered desktop app: lesson screens (SvelteKit) and the Rust core (Tauri)",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm content:check && vite build",
		"content:check": "node scripts/check-content.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:missions": "vitest run --config vitest.missions.config.ts",
		"lint": "svelte-kit sync && prettier --check . && eslint .",
		"format": "prettier --write .",
		"tauri": "tauri",
		"tokens": "node scripts/build-tokens.ts"
	},
	"license": "MIT",
	"dependencies": {
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@fontsource/source-serif-4": "^5.3.1",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2.7.3",
		"@tauri-apps/plugin-store": "^2.5.1",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"@xyflow/svelte": "^2.0.3",
		"elkjs": "^0.12.1",
		"marked": "^18.3.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.65.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.5",
		"@tauri-apps/cli": "^2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^5.1.0",
		"cn": "^0.5.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"playwright": "^1.65.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.0.16",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	},
	"private": true,
	"packageManager": "pnpm@12.23.0"
}
