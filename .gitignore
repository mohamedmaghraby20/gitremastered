# .gitignore for GitRemastered
# Lists files Git should never track. Each rule says why.

# --- Personal ---

# The maintainer's own study notes. Students never get these.
study/

# --- Large or local-only files ---

# Personal PDF copy of Pro Git (18 MB). The course reads the text source in vendor/progit2 instead.
progit.pdf

# --- JavaScript ---

# Downloaded libraries (pnpm install recreates them), at the root and in every project.
# Each app adds its own build output rules in its own .gitignore.
node_modules/

# --- Factory tools ---

# Third-party skills installed by `npx skills` (MIT, from addyosmani/agent-skills). Kept local:
# skills-lock.json is committed, so anyone can reinstall the same versions with `npx skills`.
.agents/skills/

# `npx skills` also puts Windows links (junctions) here that point into .agents/skills.
# Git handles those links badly, so we ignore them.
.claude/skills/*

# Exceptions: these are real folders, not links, so they are committed.
!.claude/skills/humanizer/
!.claude/skills/svelte-code-writer/
!.claude/skills/svelte-core-bestpractices/

# Claude Code settings for this machine only (may hold personal permissions).
.claude/settings.local.json

# --- Operating system clutter ---

# Windows folder thumbnails and settings.
Thumbs.db
desktop.ini

# macOS folder settings.
.DS_Store

# --- Local work notes ---

# Plans, todo lists and briefs used while building the app (the /plan and /build commands read them).
# Kept on the maintainer's disk only; contributors plan with GitHub issues instead.
tasks/

# Personal assistant preferences for this machine (Claude Code reads it beside CLAUDE.md).
CLAUDE.local.md
