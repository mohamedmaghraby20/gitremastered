{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "What the main window's screens are allowed to call in the Rust core",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"store:default",
		{
			"identifier": "opener:allow-open-url",
			"allow": [
				{
					"url": "https://git-scm.com/*"
				},
				{
					"url": "https://docs.github.com/*"
				}
			]
		}
	]
}
